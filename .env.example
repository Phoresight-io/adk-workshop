# ── Option A: Vertex AI + Application Default Credentials (recommended) ──────
# ADK uses ADC automatically when GOOGLE_GENAI_USE_VERTEXAI=true.
# No API key needed — run `gcloud auth application-default login` instead.
GOOGLE_CLOUD_PROJECT=qwiklabs-gcp-04-fee3bca9bd80
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

# ── Option B: Google AI Studio API key ────────────────────────────────────────
# Obtain a key at https://aistudio.google.com/app/apikey
# Comment out the Vertex AI block above and uncomment this line:
# GOOGLE_API_KEY=your_api_key_here

# ── Optional: search tool backend ────────────────────────────────────────────
# SERPER_API_KEY=your_serper_key_here
